// Covers compile-time vector expressions, copy initialization, and broadcasts.
const int4 integer_a = {20, -15, 8, 7};
const int4 integer_b = {5, 3, -2, 4};
const int4 integer_c = integer_a + integer_b;
const float4 float_a = {2.0, 4.0, 6.0, 8.0};
const float4 float_b = float_a / 2.0;

int main() {
    int4 doubled = integer_c * 2;
    float4 copied = float_b;
    putint(doubled[0] + doubled[1] + doubled[2] + doubled[3]);
    putch(10);
    putint(copied[0] + copied[1] + copied[2] + copied[3]);
    putch(10);
    return 0;
}
