// Covers unary operators applied to braced vector literals.
int main() {
    int4 positive = +{1, 2, 3, 4};
    int4 negative = -{1, 2, 3, 4};
    float4 fneg = -{1.0, 2.0, 3.0, 4.0};
    int4 nested = -(-{5, 6, 7, 8});

    putint(positive[0] + positive[1] + positive[2] + positive[3]);
    putch(10);
    putint(negative[0] + negative[1] + negative[2] + negative[3]);
    putch(10);
    putint(fneg[0] + fneg[1] + fneg[2] + fneg[3]);
    putch(10);
    putint(nested[0] + nested[1] + nested[2] + nested[3]);
    putch(10);
    return 0;
}
