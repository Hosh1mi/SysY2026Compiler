// Covers assigning a fixed-width vector literal after declaration.
int main() {
    int4 integers;
    float4 floats;
    integers = {4, 3, 2, 1};
    floats = {1.5, 2.5, 3.5, 4.5};
    putint(integers[0] + integers[1] + integers[2] + integers[3]);
    putch(10);
    putint(floats[0] + floats[1] + floats[2] + floats[3]);
    putch(10);
    return 0;
}
