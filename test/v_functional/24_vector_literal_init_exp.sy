// Covers vector literals composed inside initializers that are full expressions.
int main() {
    int4 sum = {1, 2, 3, 4} + {5, 6, 7, 8};
    int4 scaled = {1, 2, 3, 4} * 3 + {1, 1, 1, 1};
    float4 mix = {1.0, 2.0, 3.0, 4.0} * 0.5 + {0.5, 0.5, 0.5, 0.5};

    putint(sum[0] + sum[1] + sum[2] + sum[3]);
    putch(10);
    putint(scaled[0] + scaled[1] + scaled[2] + scaled[3]);
    putch(10);
    putint(mix[0] + mix[1] + mix[2] + mix[3]);
    putch(10);
    return 0;
}
