// Covers braced whole-vector assignment into multidimensional slots, and
// vector literals used directly inside arithmetic expressions.
int main() {
    int4 grid[2][2];
    float4 tiles[2][2];
    grid[0][0] = {1, 2, 3, 4};
    grid[0][1] = {5, 6, 7, 8};
    grid[1][0] = grid[0][0] * 2 + {1, 1, 1, 1};
    grid[1][1] = {9, 10, 11, 12};
    tiles[0][0] = {1.5, 2.5, 3.5, 4.5};
    tiles[1][1] = tiles[0][0] + {0.5, 0.5, 0.5, 0.5};

    putint(grid[0][0][0] + grid[0][1][1] + grid[1][0][2] + grid[1][1][3]);
    putch(10);
    putint(tiles[0][0][0] + tiles[0][0][1] + tiles[1][1][2] + tiles[1][1][3]);
    putch(10);
    return 0;
}
