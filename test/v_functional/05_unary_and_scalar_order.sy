// Covers unary vector operators and scalar operands on both arithmetic sides.
int lane_sum(int4 value) {
    return value[0] + value[1] + value[2] + value[3];
}

int main() {
    int4 value = {1, 2, 3, 4};
    int4 positive = +value;
    int4 negative = -value;
    int4 left_scalar = 100 - value;
    int4 right_scalar = value + 5;
    putint(lane_sum(positive));
    putch(10);
    putint(lane_sum(negative));
    putch(10);
    putint(lane_sum(left_scalar));
    putch(10);
    putint(lane_sum(right_scalar));
    putch(10);
    return 0;
}
