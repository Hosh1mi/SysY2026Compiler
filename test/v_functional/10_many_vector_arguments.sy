// Covers vector arguments beyond the eight SIMD argument registers.
int4 combine_int(int4 a0, int4 a1, int4 a2, int4 a3, int4 a4,
                 int4 a5, int4 a6, int4 a7, int4 a8, int4 a9) {
    return a0 + a1 + a2 + a3 + a4 + a5 + a6 + a7 + a8 + a9;
}

float4 combine_float(float4 a0, float4 a1, float4 a2, float4 a3, float4 a4,
                     float4 a5, float4 a6, float4 a7, float4 a8, float4 a9) {
    return a0 + a1 + a2 + a3 + a4 + a5 + a6 + a7 + a8 + a9;
}

int main() {
    int4 i1 = {1, 1, 1, 1};
    int4 i2 = {2, 2, 2, 2};
    int4 i3 = {3, 3, 3, 3};
    int4 i4 = {4, 4, 4, 4};
    int4 i5 = {5, 5, 5, 5};
    int4 i6 = {6, 6, 6, 6};
    int4 i7 = {7, 7, 7, 7};
    int4 i8 = {8, 8, 8, 8};
    int4 i9 = {9, 9, 9, 9};
    int4 i10 = {10, 10, 10, 10};
    float4 f1 = {1.0, 1.0, 1.0, 1.0};
    float4 f2 = {2.0, 2.0, 2.0, 2.0};
    float4 f3 = {3.0, 3.0, 3.0, 3.0};
    float4 f4 = {4.0, 4.0, 4.0, 4.0};
    float4 f5 = {5.0, 5.0, 5.0, 5.0};
    float4 f6 = {6.0, 6.0, 6.0, 6.0};
    float4 f7 = {7.0, 7.0, 7.0, 7.0};
    float4 f8 = {8.0, 8.0, 8.0, 8.0};
    float4 f9 = {9.0, 9.0, 9.0, 9.0};
    float4 f10 = {10.0, 10.0, 10.0, 10.0};
    int4 ir = combine_int(i1, i2, i3, i4, i5, i6, i7, i8, i9, i10);
    float4 fr = combine_float(f1, f2, f3, f4, f5, f6, f7, f8, f9, f10);
    putint(ir[0] + ir[1] + ir[2] + ir[3]);
    putch(10);
    putint(fr[0] + fr[1] + fr[2] + fr[3]);
    putch(10);
    return 0;
}
