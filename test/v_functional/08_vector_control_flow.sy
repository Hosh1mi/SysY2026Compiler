// Covers vector values updated across loop backedges and conditional branches.
int main() {
    int count = getint();
    int4 accumulator = {0, 0, 0, 0};
    int4 step = {1, 2, 3, 4};
    int i = 0;
    while (i < count) {
        if (i % 2 == 0) {
            accumulator = accumulator + step;
        } else {
            accumulator = accumulator - step;
        }
        step = step + 1;
        i = i + 1;
    }
    putint(accumulator[0]);
    putch(10);
    putint(accumulator[1]);
    putch(10);
    putint(accumulator[2]);
    putch(10);
    putint(accumulator[3]);
    putch(10);
    putint(accumulator[0] + accumulator[1] + accumulator[2] + accumulator[3]);
    putch(10);
    return 0;
}
