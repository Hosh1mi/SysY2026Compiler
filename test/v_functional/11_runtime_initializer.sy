// Covers non-constant vector initializers lowered through lane insertion.
int main() {
    int base = getint();
    float fraction = getfloat();
    int4 integers = {base, base + 1, base + 2, base + 3};
    float4 floats = {fraction, fraction + 1.0, fraction + 2.0,
                     fraction + 3.0};
    putint(integers[0] + integers[1] + integers[2] + integers[3]);
    putch(10);
    putint(floats[0] + floats[1] + floats[2] + floats[3]);
    putch(10);
    return 0;
}
