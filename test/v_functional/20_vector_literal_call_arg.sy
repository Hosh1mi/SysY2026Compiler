// Covers passing and receiving braced vector literals through call ABI.
int4 add_pair(int4 left, int4 right) {
    return left + right;
}

float4 scale_add(float4 value, float scale, float4 bias) {
    return value * scale + bias;
}

int main() {
    int4 integers = add_pair({1, 2, 3, 4}, {10, 20, 30, 40});
    float4 floats = scale_add({1.0, 2.0, 3.0, 4.0}, 2.0, {0.5, 0.5, 0.5, 0.5});

    putint(integers[0] + integers[1] + integers[2] + integers[3]);
    putch(10);
    putint(floats[0] + floats[1] + floats[2] + floats[3]);
    putch(10);
    putint(add_pair({1, 1, 1, 1}, add_pair({2, 2, 2, 2}, {3, 3, 3, 3}))[0]);
    putch(10);
    return 0;
}
