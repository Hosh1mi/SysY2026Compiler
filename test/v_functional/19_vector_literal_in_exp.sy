// Covers fixed-width vector literals as primary operands inside expressions.
int lane_sum_i(int4 value) {
    return value[0] + value[1] + value[2] + value[3];
}

int lane_sum_f(float4 value) {
    return value[0] + value[1] + value[2] + value[3];
}

int main() {
    int4 a = {1, 2, 3, 4};
    int4 sum = a + {5, 6, 7, 8};
    int4 product = {2, 2, 2, 2} * a - {1, 0, 1, 0};
    int4 mixed = ({1, 1, 1, 1} + a) * 3;
    float4 f = {1.0, 2.0, 3.0, 4.0};
    float4 scaled = f * {0.5, 0.5, 0.5, 0.5} + {1.0, 1.0, 1.0, 1.0};

    putint(lane_sum_i(sum));
    putch(10);
    putint(lane_sum_i(product));
    putch(10);
    putint(lane_sum_i(mixed));
    putch(10);
    putint(lane_sum_f(scaled));
    putch(10);
    putint(({9, 8, 7, 6})[0] + ({9, 8, 7, 6})[3]);
    putch(10);
    return 0;
}
