// Covers int4 and float4 arguments, scalar broadcasts, and vector return values.
int4 integer_mix(int4 a, int4 b, int scale) {
    return a * b + scale;
}

float4 float_mix(float4 a, float4 b, float scale) {
    return a + b * scale;
}

int main() {
    int4 ia = {1, 2, 3, 4};
    int4 ib = {5, 6, 7, 8};
    float4 fa = {1.0, 2.0, 3.0, 4.0};
    float4 fb = {0.5, 1.5, 2.5, 3.5};
    int4 ir = integer_mix(ia, ib, 2);
    float4 fr = float_mix(fa, fb, 2.0);
    putint(ir[0] + ir[1] + ir[2] + ir[3]);
    putch(10);
    putint(fr[0] + fr[1] + fr[2] + fr[3]);
    putch(10);
    return 0;
}
