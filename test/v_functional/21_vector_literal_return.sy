// Covers returning braced vector literals from functions.
int4 make_int4(int base) {
    return {base, base + 1, base + 2, base + 3};
}

float4 make_float4() {
    return {1.5, 2.5, 3.5, 4.5};
}

int4 identity(int4 value) {
    return value;
}

int main() {
    int4 integers = make_int4(10);
    float4 floats = make_float4();
    int4 passed = identity({4, 3, 2, 1});

    putint(integers[0] + integers[1] + integers[2] + integers[3]);
    putch(10);
    putint(floats[0] + floats[1] + floats[2] + floats[3]);
    putch(10);
    putint(passed[0] + passed[1] + passed[2] + passed[3]);
    putch(10);
    putint(make_int4(1)[0] + make_int4(1)[3]);
    putch(10);
    return 0;
}
