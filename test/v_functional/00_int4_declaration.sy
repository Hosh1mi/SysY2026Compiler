// Covers zero, full, partial, global, local, and const int4 initialization.
int4 global_zero;
int4 global_data = {1, -2, 3, -4};
const int4 global_weights = {8, 6, 4, 2};

int main() {
    int4 local = {5, 6};
    putint(global_zero[0] + global_zero[1] + global_zero[2] + global_zero[3]);
    putch(10);
    putint(global_data[0] + global_data[1] + global_data[2] + global_data[3]);
    putch(10);
    putint(global_weights[0] + global_weights[1] + global_weights[2] + global_weights[3]);
    putch(10);
    putint(local[0] + local[1] + local[2] + local[3]);
    putch(10);
    return 0;
}
