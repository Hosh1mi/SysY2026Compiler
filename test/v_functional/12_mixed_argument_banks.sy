// Covers independent integer and SIMD argument banks with interleaved vectors.
int4 mixed(int i0, float f0, int4 a, float4 b,
           int i1, float f1, int4 c, float4 d) {
    return a * i0 + c * i1 + f0 + f1 + b[0] + d[3];
}

int main() {
    int4 a = {1, 2, 3, 4};
    int4 c = {5, 6, 7, 8};
    float4 b = {1.0, 2.0, 3.0, 4.0};
    float4 d = {5.0, 6.0, 7.0, 8.0};
    int4 result = mixed(2, 3.0, a, b, 4, 5.0, c, d);
    putint(result[0] + result[1] + result[2] + result[3]);
    putch(10);
    return 0;
}
