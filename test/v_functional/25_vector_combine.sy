// Covers vector reconstruction from extracted lanes and lane-local arithmetic.
int main() {
    int seed = getint();
    int4 left = {seed, seed + 1, seed + 2, seed + 3};
    int4 right = {seed + 10, seed + 11, seed + 12, seed + 13};
    int4 negative = -left;

    int4 zipped = {left[0], right[0], left[1], right[1]};
    int lane_sum = left[2] + right[2];
    int4 combined = zipped + lane_sum;
    int4 swapped = {combined[1], combined[0],
                    combined[3], combined[2]};
    int4 restored = {swapped[1], swapped[0],
                     swapped[3], swapped[2]};

    putint(restored[0]);
    putch(32);
    putint(restored[1]);
    putch(32);
    putint(restored[2]);
    putch(32);
    putint(restored[3]);
    putch(10);
    putint(negative[3]);
    putch(10);
    return 0;
}
