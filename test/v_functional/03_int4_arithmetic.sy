// Covers all int4 arithmetic operators and runtime scalar broadcasting.
int lane_sum(int4 value) {
    return value[0] + value[1] + value[2] + value[3];
}

int main() {
    int scale = getint();
    int bias = getint();
    int4 a = {24, -18, 7, 9};
    int4 b = {6, 3, -2, 4};
    int4 sum = a + b;
    int4 difference = a - b;
    int4 product = a * b;
    int4 quotient = a / b;
    int4 remainder = a % b;
    int4 scaled = a * scale - bias;
    putint(lane_sum(sum));
    putch(10);
    putint(lane_sum(difference));
    putch(10);
    putint(lane_sum(product));
    putch(10);
    putint(lane_sum(quotient));
    putch(10);
    putint(lane_sum(remainder));
    putch(10);
    putint(lane_sum(scaled));
    putch(10);
    return 0;
}
