// Covers arbitrary one-source and two-source vector permutations.
int main() {
    int seed = getint();
    int4 left = {seed, seed + 1, seed + 2, seed + 3};
    int4 right = {seed + 10, seed + 11, seed + 12, seed + 13};
    int4 mixed = {left[3], right[0], left[1], right[2]};

    float4 values = {1.5, 2.5, 3.5, 4.5};
    float4 permuted = {values[2], values[0], values[3], values[1]};

    putint(mixed[0]);
    putch(32);
    putint(mixed[1]);
    putch(32);
    putint(mixed[2]);
    putch(32);
    putint(mixed[3]);
    putch(10);
    putint(permuted[0] * 10.0);
    putch(32);
    putint(permuted[1] * 10.0);
    putch(32);
    putint(permuted[2] * 10.0);
    putch(32);
    putint(permuted[3] * 10.0);
    putch(10);
    return 0;
}
