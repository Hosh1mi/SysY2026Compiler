int A[4][4];
int B[4][4];
int C[4][4];

int main() {
    int i = 0;
    while (i < 4) {
        int j = 0;
        while (j < 4) {
            A[i][j] = 1;
            B[i][j] = i + j;
            C[i][j] = 0;
            j = j + 1;
        }
        i = i + 1;
    }

    int k = 0;
    while (k < 4) {
        i = 0;
        while (i < 4) {
            int j = 0;
            while (j < 4) {
                C[i][j] = C[i][j] * A[i][k] + B[k][j];
                j = j + 1;
            }
            i = i + 1;
        }
        k = k + 1;
    }

    int total = 0;
    i = 0;
    while (i < 4) {
        int j = 0;
        while (j < 4) {
            total = total + C[i][j];
            j = j + 1;
        }
        i = i + 1;
    }
    putint(total);
    putch(10);
    return 0;
}
