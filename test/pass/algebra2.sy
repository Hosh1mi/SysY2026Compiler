int main() {
    int x;
    x = 10; // 未知值
    int a, b, c, d, e, f, g, h, i, j, k, l, m, n;
    
    // 测试 shl 优化
    a = 4 << 2;          // 常量折叠，应变为 16
    b = x << 0;          // 恒等，应变为 x
    c = x << 32;         // overshift，应变为 0 (假设32位)
    d = (x << 2) << 3;   // 冗余合并 -> x << 5
    e = 1 << x;          // 规范化：常量左移变量 -> 变量左移常量

    // 测试 ashr 优化
    f = (-16) >> 2;      // 常量折叠：-16 >> 2 = -4
    g = x >> 0;          // 恒等
    h = x >> 33;         // overshift 变为 x >> 31
    i = (x >> 1) >> 2;   // 合并 -> x >> 3
    j = 8 >> x;          // 规范化：常量算术右移变量 -> 变量算术右移常量

    // 混合，避免死代码消除
    return a + b + c + d + e + f + g + h + i + j;
}