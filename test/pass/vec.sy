// kernel.sy
int A[1024][1024];
int B[1024][1024];
int C[1024][1024];

int fun(int T, int R) {
    int i, j, r;
    
    // 简单初始化，赋有意义的值
    i = 0;
    while (i < T) {
        j = 0;
        while (j < T) {
            A[i][j] = i + j;
            B[i][j] = i - j;
            j = j + 1;
        }
        i = i + 1;
    }

    //starttime();

    r = 0;
    int total;
    while (r < R) {
        // 内核1: 读 A,B -> 乘加/平方/除法 -> 写 C
        i = 0;
        while (i < T) {
            j = 0;
            while (j < T) {
                int tmp = A[i][j] * 2 + B[i][j] * 3;
                tmp = tmp * tmp + 7;
                tmp = tmp / 3;
                C[i][j] = tmp;
                j = j + 1;
            }
            i = i + 1;
        }

        // 内核2: 读 C -> 平方求和规约
        total = 0;
        i = 0;
        while (i < T) {
            j = 0;
            while (j < T) {
                total = total + C[i][j] * C[i][j];
                j = j + 1;
            }
            i = i + 1;
        }

        r = r + 1;
    }

    //stoptime();
    return total;   // 返回值防止 total 被死代码消除
}
