// constant_fold_test.sy

int test_add_int() {
    // 8
    return 3 + 5;
}

int test_chain_int() {
    // 16
    return (3 + 5) * 2;
}

int test_icmp() {
    // false (i1 0)
    if (3 > 5) {
        return 1;
    } else {
        return 0;
    }
}



int test_fadd() {
    float x = 1.5 + 2.5;
    return x;  // 4.0 / 4??
}

int test_fcmp() {
    // false (i1 0)
    if (2.0 > 3.0) {
        return 1;
    } else {
        return 0;
    }
}

int test_srem() {
    // 1
    return 10 % 3;
}

int main() {
    return test_add_int() + test_chain_int() + test_icmp() +
        test_fadd() + test_fcmp() + test_srem();
}