int main() {
    int a = 10;
    int b = 254;
    int u = 100;
    int result = 0;
    int pass = 1;

    // ========== 乘法测试：乘以2的幂 ==========
    // a * 8 应该优化为 a << 3
    if (a * 8 != 80) pass = 0;
    // a * 16 应该优化为 a << 4
    if (a * 16 != 160) pass = 0;
    // a * 1024 应该优化为 a << 10
    if (a * 1024 != 10240) pass = 0;
    // 变量 * 2的幂
    if (b * 4 != 1016) pass = 0;
    // 2的幂 * 变量 (交换律)
    if (32 * a != 320) pass = 0;

    // ========== 除法测试：有符号除以2的幂 ==========
    // a / 2 应该优化为 a >> 1
    if (a / 2 != 5) pass = 0;
    // a / 4 应该优化为 a >> 2
    if (a / 4 != 2) pass = 0;
    // b / 16 应该优化为 b >> 4
    if (b / 16 != 15) pass = 0;

    // ========== 除法测试：无符号除以2的幂 ==========
    // u / 2 应该优化为 u >> 1 (逻辑右移)
    if (u / 2 != 50) pass = 0;
    // u / 8 应该优化为 u >> 3
    if (u / 8 != 12) pass = 0;

    // ========== 取模测试：2的幂 ==========
    // a % 8 应该优化为 a & 7
    if (a % 8 != 2) pass = 0;
    // a % 16 应该优化为 a & 15
    if (a % 16 != 10) pass = 0;
    // u % 4 应该优化为 u & 3
    if (u % 4 != 0) pass = 0;
    // b % 64 应该优化为 b & 63
    if (b % 64 != 62) pass = 0;

    // ========== 负数除法测试 ==========
    // 负数除以2的幂，需要用算术右移+修正
    // -20 / 4 = -5, 不能简单算术右移2位
    if ((-20) / 4 != -5) pass = 0;
    // -127 / 8 = -16 (向零取整)
    if ((-127) / 8 != -15) pass = 0;

    // ========== 负数取模测试 ==========
    // SysY/C语言中 a % b 的符号与 a 相同
    // -20 % 8 = -4
    if ((-20) % 8 != -4) pass = 0;

    // ========== 组合测试 ==========
    // (a * 16 + b / 8) % 32
    // = (10<<4 + 254>>3) & 31
    // = (160 + 31) & 31
    // = 191 & 31 = 31
    if ((a * 16 + b / 8) % 32 != 31) pass = 0;

    // ========== 乘加测试 ==========
    // a * 9 = a * (8 + 1) = a << 3 + a
    // 这是更高级的强度削弱，不是纯移位
    if (a * 9 != 90) pass = 0;

    // ========== 结果输出 ==========
    if (pass == 1) {
        result = 0;   // 所有测试通过
    } else {
        result = 1;   // 有测试失败
    }

    return result;
}