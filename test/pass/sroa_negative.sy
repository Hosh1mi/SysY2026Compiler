// =============================================================================
// SROA 安全性测试 —— 验证 SROA 不会错误修改不安全的 alloca
// =============================================================================
//
// 本测试同时包含 SROA "应该处理" 和 "不应处理" 的场景。
// 用 -O1 -c 编译后检查 IR：
//   - case_clean 中应看不到 alloca [5 x i32]（被 SROA 拆分）
//   - case_init / case_var / case_escape 中应仍保留 alloca [N x i32]
//   - 所有函数返回值正确，证明 SROA 没有破坏语义
//
// =============================================================================


// ---- 反面 2：变量下标 → SROA 应跳过 ----
// GEP 索引不是 ConstantInt → 无法静态确定元素 → 不可拆分
int case_var(int idx) {
    int arr[10];
    arr[0] = 100;
    arr[idx] = 200; // 变量下标！SROA 必须跳过整个数组
    arr[1] = 300;   // 即使有其他常量下标的访问也不应拆分
    return arr[0];  // 100（idx=3 时 arr[0] 未被覆盖）
}



// ---- 反面 4：多维数组部分下标 → SROA 应跳过 ----
// 若 GEP 结果仍为聚合指针（非标量）→ 不可拆分
int case_2d_var(int row) {
    int mat[3][4];
    mat[0][0] = 1;
    mat[0][1] = 2;
    mat[row][2] = 99;     // 变量下标 → 跳过
    mat[0][3] = 4;
    return mat[0][0] + mat[0][1] + mat[0][3]; // 1 + 2 + 4 = 7
}

// ---- 入口 ----
int main() {
    if (case_var(3) != 100) return 3;
    // if (case_escape() != 999) return 4;
    // if (case_2d_var(1) != 7) return 5;
    return 0; // 全部通过
}
