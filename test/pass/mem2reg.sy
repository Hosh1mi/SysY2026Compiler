int main() {
    int A = 100, B = 200;
    int i = 0;
    while (i < 1) {
        int temp = A;
        int j = 0;
        while (j < 2) {
            temp = temp * 2;
            j = j + 1;
        }
        A = B;
        B = temp;
        i = i + 1;
    }
    int out[2];
    out[0] = A;
    out[1] = B;
    putarray(2, out);
    return 0;
}