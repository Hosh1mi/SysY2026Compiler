int fold(int value, int count) {
    if (count == 0) return 0;
    if (count == 1) return value % 97;
    int current = fold(value, count / 2);
    current = (current + current) % 97;
    if (count % 2 == 1) return (current + value) % 97;
    return current;
}

int main() {
    int n = getint();
    while (n > 0) {
        int value = getint();
        int count = getint();
        putint(fold(value, count));
        putch(10);
        n = n - 1;
    }
    return 0;
}
