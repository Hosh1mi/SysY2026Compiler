// =============================================================================
// SROA Pass 测试
// =============================================================================
// 测试 SROA 将聚合类型（ArrayType）alloca 拆分为标量 alloca。
// int arr[10];（无初始化）→ 前端不生成 bitcast，SROA 可以匹配。
//
// 当前 SROA 要求所有元素下标为编译期常量，故本测试全部使用常量下标。
//
// 编译方式：
//   -O0 -c → 原始 alloca [10 x i32] + GEP + load/store
//   -O1 -c → SROA → Mem2Reg 后，alloca/GEP/load/store 全部消除
// =============================================================================

int main() {
  int arr[10];  // 无初始化 → alloca [10 x i32]，无 bitcast

  // 常量下标写
  arr[0] = 10;
  arr[1] = 20;
  arr[2] = 30;
  arr[3] = arr[0] + arr[1];  // 30   (读 arr[0], arr[1]; 写 arr[3])
  arr[4] = arr[2] + arr[3];  // 60   (读 arr[2], arr[3]; 写 arr[4])
  arr[5] = arr[3] * arr[4];  // 1800 (读 arr[3], arr[4]; 写 arr[5])

  // 交叉读写：arr[1] 先读后写
  arr[6] = arr[1] + arr[5];  // 1820 (读 arr[1], arr[5]; 写 arr[6])
  arr[1] = 99;               // 覆写 arr[1]，不影响 arr[6]

  // 只读不写后续元素的场景（arr[7], arr[8], arr[9] 从未被访问）
  // → SROA 只为 arr[0..6] 创建标量 alloca

  return arr[6];  // 期望: 1820
}
