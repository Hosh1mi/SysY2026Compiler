// Sustained in-place int4 streaming updates with sweep-carried dependence.
const int N = 65536;
const int SWEEPS = 4096;
int4 state[N];
int4 bias[N];

int main() {
    // Opaque zero keeps a loop-carried edge without changing values.
    int zero = getint();
    int i = 0;
    while (i < N) {
        state[i] = {1, 2, 3, 4};
        bias[i] = {1, 1, 1, 1};
        i = i + 1;
    }

    starttime();
    int sweep = 0;
    while (sweep < SWEEPS) {
        i = 0;
        int4 carry = {0, 0, 0, 0};
        while (i < N) {
            state[i] = state[i] + bias[i] + carry * zero;
            carry = state[i];
            i = i + 1;
        }
        sweep = sweep + 1;
    }
    stoptime();

    int checksum = 0;
    i = 0;
    while (i < N) {
        checksum = checksum + state[i][0] + state[i][1]
                            + state[i][2] + state[i][3];
        i = i + 1;
    }
    putint(checksum);
    putch(10);
    return 0;
}
