// Vector dot-product reduction with per-sweep array mutation feedback.
const int N = 32768;
const int SWEEPS = 2048;
const int MOD = 10007;
int4 left[N];
int4 right[N];

int main() {
    int i = 0;
    while (i < N) {
        left[i] = {1, 2, 3, 4};
        right[i] = {5, 6, 7, 8};
        i = i + 1;
    }

    starttime();
    int4 total = {0, 0, 0, 0};
    int sweep = 0;
    while (sweep < SWEEPS) {
        int4 accumulator = {0, 0, 0, 0};
        i = 0;
        while (i < N) {
            accumulator = accumulator + left[i] * right[i];
            left[i] = (left[i] + 1) % MOD;
            i = i + 1;
        }
        total = (total + accumulator) % MOD;
        sweep = sweep + 1;
    }
    stoptime();

    putint(total[0] + total[1] + total[2] + total[3]);
    putch(10);
    return 0;
}
