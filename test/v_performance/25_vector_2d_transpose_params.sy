// Measures whole-vector transposes through multidimensional array parameters.
const int W = 96;
const int SWEEPS = 256;
int4 first[W][W];
int4 second[W][W];

void transpose_add(int4 source[][W], int4 destination[][W], int bias) {
    int row = 0;
    while (row < W) {
        int col = 0;
        while (col < W) {
            destination[col][row] = (source[row][col] + bias) % 1009;
            col = col + 1;
        }
        row = row + 1;
    }
}

int main() {
    int seed = getint();
    int row = 0;
    while (row < W) {
        int col = 0;
        while (col < W) {
            int base = (row * W + col + seed) % 1009;
            first[row][col] = {base, base + 1, base + 2, base + 3};
            col = col + 1;
        }
        row = row + 1;
    }

    starttime();
    int sweep = 0;
    while (sweep < SWEEPS) {
        transpose_add(first, second, sweep % 7);
        transpose_add(second, first, sweep % 11);
        sweep = sweep + 1;
    }
    stoptime();

    int checksum = 0;
    row = 0;
    while (row < W) {
        int4 value = first[row][(row * 17) % W];
        checksum = (checksum + value[0] + value[1] + value[2] + value[3])
                   % 1000000007;
        row = row + 1;
    }
    putint(checksum);
    putch(10);
    return 0;
}
