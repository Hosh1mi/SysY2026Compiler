// Measures horizontal lane sums followed by scalar-to-vector normalization.
const int N = 32768;
const int SWEEPS = 512;
float4 values[N];

int main() {
    float seed = getfloat();
    int i = 0;
    while (i < N) {
        float base = (i % 29 + 1) * 0.125 + seed;
        values[i] = base + {1.0, 2.0, 3.0, 4.0};
        i = i + 1;
    }

    starttime();
    int sweep = 0;
    while (sweep < SWEEPS) {
        i = 0;
        while (i < N) {
            float4 value = values[i];
            float sum = value[0] + value[1] + value[2] + value[3] + 0.001;
            values[i] = value / sum + {0.1, 0.2, 0.3, 0.4};
            i = i + 1;
        }
        sweep = sweep + 1;
    }
    stoptime();

    int checksum = 0;
    i = 0;
    while (i < N) {
        int l0 = values[i][0] * 100000.0;
        int l1 = values[i][1] * 100000.0;
        int l2 = values[i][2] * 100000.0;
        int l3 = values[i][3] * 100000.0;
        checksum = (checksum + l0 + l1 + l2 + l3) % 1000000007;
        i = i + 1;
    }
    putint(checksum);
    putch(10);
    return 0;
}
