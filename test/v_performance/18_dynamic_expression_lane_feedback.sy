// Runtime feedback kernel for extracting a dynamic lane from a vector value.
const int N = 8192;
const int SWEEPS = 256;
const int MOD = 1009;
int4 values[N];

int main() {
    int seed = getint();
    int i = 0;
    while (i < N) {
        int base = (seed + i) % MOD;
        values[i] = {base, base + 1, base + 2, base + 3};
        i = i + 1;
    }

    starttime();
    int checksum = 0;
    int sweep = 0;
    while (sweep < SWEEPS) {
        i = 0;
        while (i < N) {
            int lane = (i + sweep) % 4;
            int other_lane = (lane + 2) % 4;
            int4 current = values[i];
            checksum = checksum + (current + sweep)[lane]
                       - (current - sweep)[other_lane];
            i = i + 1;
        }
        sweep = sweep + 1;
    }
    stoptime();

    putint(checksum);
    putch(10);
    return 0;
}
