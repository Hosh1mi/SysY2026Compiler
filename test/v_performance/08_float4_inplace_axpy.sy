// In-place float4 saxpy sweeps with a runtime scale and carried dependence.
const int N = 65536;
const int SWEEPS = 4096;
float4 state[N];
float4 bias[N];

int main() {
    float scale = getfloat();
    int i = 0;
    while (i < N) {
        state[i] = {1.0, 1.0, 1.0, 1.0};
        bias[i] = {0.25, 0.5, 0.75, 1.0};
        i = i + 1;
    }

    starttime();
    int sweep = 0;
    while (sweep < SWEEPS) {
        i = 0;
        while (i < N) {
            state[i] = state[i] * scale + bias[i];
            i = i + 1;
        }
        sweep = sweep + 1;
    }
    stoptime();

    int checksum = 0;
    i = 0;
    while (i < N) {
        int l0 = state[i][0];
        int l1 = state[i][1];
        int l2 = state[i][2];
        int l3 = state[i][3];
        checksum = checksum + l0 + l1 + l2 + l3;
        i = i + 1;
    }
    putint(checksum);
    putch(10);
    return 0;
}
