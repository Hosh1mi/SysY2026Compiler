// Stresses candidate VecType spellings through equivalent hot call chains.
const int LANES = 4;
const int ITERATIONS = 16777216;

vector<int, LANES> int_step_a(vector<LANES, int> value, int bias) {
    return value * 3 + bias;
}

vec(int, 4) int_step_b(vec[int, 4] value) {
    return value % 1009;
}

int<4> int_step_c(v4i32 value) {
    return value + {1, 2, 3, 4};
}

vector<float, 4> float_step_a(vector<4, float> value) {
    return value * 0.999 + {0.001, 0.002, 0.003, 0.004};
}

vec(float, 4) float_step_b(vec[float, 4] value) {
    return value + 0.125;
}

float[4] float_step_c(f32x4 value) {
    return value * 0.5;
}

int main() {
    int seed = getint();
    vector<int, LANES> integers = {seed, seed + 1, seed + 2, seed + 3};
    vector<float, LANES> floats = {1.0, 1.5, 2.0, 2.5};

    starttime();
    int i = 0;
    while (i < ITERATIONS) {
        integers = int_step_c(int_step_b(int_step_a(integers, i % 17)));
        floats = float_step_c(float_step_b(float_step_a(floats)));
        i = i + 1;
    }
    stoptime();

    putint(integers[0] + integers[1] + integers[2] + integers[3]);
    putch(10);
    int float_sum = (floats[0] + floats[1] + floats[2] + floats[3]) * 1000.0;
    putint(float_sum);
    putch(10);
    return 0;
}
