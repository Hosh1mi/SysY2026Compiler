// Measures runtime lane insertion with a changing destination lane.
const int N = 16384;
const int SWEEPS = 512;
int4 values[N];

int main() {
    int seed = getint();
    int i = 0;
    while (i < N) {
        int base = (i + seed) % 1009;
        values[i] = {base, base + 1, base + 2, base + 3};
        i = i + 1;
    }

    starttime();
    int sweep = 0;
    while (sweep < SWEEPS) {
        i = 0;
        while (i < N) {
            int lane = (i + sweep) % 4;
            int source_lane = (lane + 1) % 4;
            int4 current = values[i];
            current[lane] = (current[source_lane] * 3 + i + sweep) % 1009;
            values[i] = current;
            i = i + 1;
        }
        sweep = sweep + 1;
    }
    stoptime();

    int checksum = 0;
    i = 0;
    while (i < N) {
        checksum = (checksum + values[i][0] + values[i][1]
                    + values[i][2] + values[i][3]) % 1000000007;
        i = i + 1;
    }
    putint(checksum);
    putch(10);
    return 0;
}
