// Measures long dependent float4 multiply-add chains in Horner evaluation.
const int TERMS = 32;
const int ITERATIONS = 1048576;
float4 coefficients[TERMS];

float4 evaluate(float4 point) {
    float4 result = coefficients[TERMS - 1];
    int term = TERMS - 2;
    while (term >= 0) {
        result = result * point + coefficients[term];
        term = term - 1;
    }
    return result;
}

int main() {
    float seed = getfloat();
    int term = 0;
    while (term < TERMS) {
        float base = (term % 7 + 1) * 0.0001;
        coefficients[term] = base + {0.0001, 0.0002, 0.0003, 0.0004};
        term = term + 1;
    }

    starttime();
    int i = 0;
    float4 total = {0.0, 0.0, 0.0, 0.0};
    while (i < ITERATIONS) {
        float offset = (i % 17) * 0.00001;
        float4 point = seed + offset + {0.75, 0.8, 0.85, 0.9};
        total = total + evaluate(point);
        i = i + 1;
    }
    stoptime();

    int checksum = total[0] + total[1] + total[2] + total[3];
    putint(checksum);
    putch(10);
    return 0;
}
