// Measures vector accumulation followed by a scalar horizontal checksum.
const int N = 4096;
const int REPEAT = 512;
int4 left[N];
int4 right[N];
int4 sink;

int main() {
    int i = 0;
    while (i < N) {
        left[i] = {1, 2, 3, 4};
        right[i] = {5, 6, 7, 8};
        i = i + 1;
    }

    starttime();
    int repeat = 0;
    while (repeat < REPEAT) {
        int4 accumulator = {0, 0, 0, 0};
        i = 0;
        while (i < N) {
            accumulator = accumulator + left[i] * right[i];
            i = i + 1;
        }
        sink = accumulator;
        repeat = repeat + 1;
    }
    stoptime();

    putint(sink[0] + sink[1] + sink[2] + sink[3]);
    putch(10);
    return 0;
}
