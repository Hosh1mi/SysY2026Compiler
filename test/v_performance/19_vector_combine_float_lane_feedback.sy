// Runtime feedback kernel for combining float lane arithmetic with rebuilds.
const int N = 16384;
const int SWEEPS = 512;
const int MOD = 251;
float4 left_values[N];
float4 right_values[N];
float4 output_values[N];

int main() {
    int seed = getint();
    int i = 0;
    while (i < N) {
        int base = (seed + i) % MOD;
        float fbase = base;
        left_values[i] = fbase + {0.0, 1.0, 2.0, 3.0};
        right_values[i] = fbase + {7.0, 8.0, 9.0, 10.0};
        i = i + 1;
    }

    starttime();
    int sweep = 0;
    while (sweep < SWEEPS) {
        i = 0;
        while (i < N) {
            float4 left = left_values[i];
            float4 right = right_values[i];
            float lane_product = left[2] * right[2];
            float4 mixed = {left[0], right[0], left[1], right[1]};
            output_values[i] = mixed + lane_product + sweep;
            i = i + 1;
        }
        sweep = sweep + 1;
    }
    stoptime();

    float4 value = output_values[0];
    int checksum = value[0] + value[1] + value[2] + value[3];
    putint(checksum);
    putch(10);
    return 0;
}
