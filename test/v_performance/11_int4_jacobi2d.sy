// Multi-iteration Jacobi-style smoothing over an int4 2D grid.
const int H = 192;
const int W = 192;
const int ITER = 768;
int4 cur[H][W];
int4 nxt[H][W];

int main() {
    int y = 0;
    while (y < H) {
        int x = 0;
        while (x < W) {
            cur[y][x] = {x + 1, y + 1, x + y + 1, (x * 3 + y * 5) % 97 + 1};
            nxt[y][x] = {0, 0, 0, 0};
            x = x + 1;
        }
        y = y + 1;
    }

    starttime();
    int iter = 0;
    while (iter < ITER) {
        y = 1;
        while (y < H - 1) {
            int x = 1;
            while (x < W - 1) {
                nxt[y][x] = (cur[y][x - 1] + cur[y][x] * 2 + cur[y][x + 1]
                             + cur[y - 1][x] + cur[y + 1][x]) / 6;
                x = x + 1;
            }
            y = y + 1;
        }
        y = 1;
        while (y < H - 1) {
            int x = 1;
            while (x < W - 1) {
                cur[y][x] = nxt[y][x];
                x = x + 1;
            }
            y = y + 1;
        }
        iter = iter + 1;
    }
    stoptime();

    int checksum = 0;
    y = 0;
    while (y < H) {
        int x = 0;
        while (x < W) {
            checksum = checksum + cur[y][x][0] + cur[y][x][1]
                                + cur[y][x][2] + cur[y][x][3];
            x = x + 1;
        }
        y = y + 1;
    }
    putint(checksum);
    putch(10);
    return 0;
}
