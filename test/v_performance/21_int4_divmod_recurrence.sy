// Measures vector-by-vector integer division and remainder in a feedback loop.
const int N = 8192;
const int SWEEPS = 512;
int4 values[N];
int4 divisors[N];

int main() {
    int seed = getint();
    int i = 0;
    while (i < N) {
        int base = (i + seed) % 997 + 1000;
        values[i] = {base, base + 101, base + 203, base + 307};
        divisors[i] = {3, 5, 7, 11};
        i = i + 1;
    }

    starttime();
    int sweep = 0;
    while (sweep < SWEEPS) {
        i = 0;
        while (i < N) {
            int4 quotient = values[i] / divisors[i];
            int4 remainder = values[i] % divisors[i];
            values[i] = (quotient * 13 + remainder * 17 + sweep) % 1009;
            divisors[i] = (divisors[i] + {1, 2, 3, 4}) % 29 + 1;
            i = i + 1;
        }
        sweep = sweep + 1;
    }
    stoptime();

    int checksum = 0;
    i = 0;
    while (i < N) {
        checksum = (checksum + values[i][0] + values[i][1]
                    + values[i][2] + values[i][3]) % 1000000007;
        i = i + 1;
    }
    putint(checksum);
    putch(10);
    return 0;
}
