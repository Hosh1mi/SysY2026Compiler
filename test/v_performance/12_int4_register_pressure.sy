// Hot int4 kernel with many simultaneously live vectors to stress allocation.
const int N = 16384;
const int SWEEPS = 1536;
const int MOD = 10007;
int4 a[N];
int4 b[N];
int4 c[N];
int4 d[N];
int4 out[N];

int4 heavy(int4 v0, int4 v1, int4 v2, int4 v3) {
    int4 t0 = v0 * 3 + v1;
    int4 t1 = v1 * 5 + v2;
    int4 t2 = v2 * 7 + v3;
    int4 t3 = v3 * 9 + v0;
    int4 u0 = t0 * t1 + t2;
    int4 u1 = t1 * t2 + t3;
    int4 u2 = t2 * t3 + t0;
    int4 u3 = t3 * t0 + t1;
    return ((u0 + u1) + (u2 + u3)) % MOD;
}

int main() {
    int i = 0;
    while (i < N) {
        a[i] = {1, 2, 3, 4};
        b[i] = {2, 3, 4, 5};
        c[i] = {3, 4, 5, 6};
        d[i] = {4, 5, 6, 7};
        i = i + 1;
    }

    starttime();
    int sweep = 0;
    int checksum = 0;
    while (sweep < SWEEPS) {
        i = 0;
        while (i < N) {
            out[i] = heavy(a[i], b[i], c[i], d[i]);
            a[i] = (a[i] + (out[i] % 17)) % MOD;
            checksum = (checksum + out[i][0] + out[i][1]
                        + out[i][2] + out[i][3]) % 1000000007;
            i = i + 1;
        }
        sweep = sweep + 1;
    }
    stoptime();

    i = 0;
    while (i < N) {
        checksum = (checksum + a[i][0]) % 1000000007;
        i = i + 1;
    }
    putint(checksum);
    putch(10);
    return 0;
}
