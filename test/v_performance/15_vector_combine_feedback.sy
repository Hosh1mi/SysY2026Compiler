// Runtime-dependent feedback kernel for extract/insert and shuffle combining.
const int N = 16384;
const int SWEEPS = 512;
const int MOD = 1009;
int4 left_values[N];
int4 right_values[N];

int main() {
    int seed = getint();
    int i = 0;
    while (i < N) {
        int base = (seed + i) % MOD;
        left_values[i] = {base, base + 1, base + 2, base + 3};
        right_values[i] = {base + 7, base + 8, base + 9, base + 10};
        i = i + 1;
    }

    starttime();
    int sweep = 0;
    while (sweep < SWEEPS) {
        i = 0;
        while (i < N) {
            int4 left = left_values[i];
            int4 right = right_values[i];
            int lane_sum = left[2] + right[2];
            int4 low = {left[0], right[0], left[1], right[1]};
            left_values[i] = (low + lane_sum) % MOD;
            right_values[i] = (right + sweep + 1) % MOD;
            i = i + 1;
        }
        sweep = sweep + 1;
    }
    stoptime();

    int checksum = 0;
    i = 0;
    while (i < N) {
        int4 left = left_values[i];
        int4 right = right_values[i];
        checksum = (checksum + left[0] + left[1] + left[2] + left[3]
                    + right[0] + right[1] + right[2] + right[3])
                   % 1000000007;
        i = i + 1;
    }
    putint(checksum);
    putch(10);
    return 0;
}
