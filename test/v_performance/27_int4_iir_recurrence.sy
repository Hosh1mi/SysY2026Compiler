// Measures a genuine loop-carried int4 recurrence across a long input stream.
const int N = 32768;
const int SWEEPS = 512;
int4 samples[N];
int4 output[N];

int main() {
    int seed = getint();
    int i = 0;
    while (i < N) {
        int base = (i * 13 + seed) % 1009;
        samples[i] = {base, base + 3, base + 5, base + 7};
        i = i + 1;
    }

    starttime();
    int sweep = 0;
    int4 carry = {1, 2, 3, 4};
    while (sweep < SWEEPS) {
        i = 0;
        while (i < N) {
            carry = (carry * {3, 5, 7, 9} + samples[i]) % 1009;
            output[i] = carry;
            i = i + 1;
        }
        samples[sweep % N] = carry;
        sweep = sweep + 1;
    }
    stoptime();

    int checksum = 0;
    i = 0;
    while (i < N) {
        checksum = (checksum + output[i][0] + output[i][1]
                    + output[i][2] + output[i][3]) % 1000000007;
        i = i + 1;
    }
    putint(checksum);
    putch(10);
    return 0;
}
