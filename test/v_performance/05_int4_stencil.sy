// Measures neighboring int4 loads and stores over a cache-resident stencil.
const int N = 4096;
const int REPEAT = 256;
int4 source[N];
int4 result[N];

int main() {
    int i = 0;
    while (i < N) {
        source[i] = {1, 2, 3, 4};
        i = i + 1;
    }

    starttime();
    int repeat = 0;
    while (repeat < REPEAT) {
        i = 1;
        while (i < N - 1) {
            result[i] = source[i - 1] + source[i] * 2 + source[i + 1];
            i = i + 1;
        }
        repeat = repeat + 1;
    }
    stoptime();

    int checksum = 0;
    i = 0;
    while (i < N) {
        checksum = checksum + result[i][0] + result[i][1]
                            + result[i][2] + result[i][3];
        i = i + 1;
    }
    putint(checksum);
    putch(10);
    return 0;
}
