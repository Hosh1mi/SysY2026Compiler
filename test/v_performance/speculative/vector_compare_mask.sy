// Specifies lane-wise comparison masks once relational vector syntax is fixed.
const int N = 16384;
const int SWEEPS = 512;
int4 integers[N];
float4 floats[N];
int4 masks[N];

int main() {
    int seed = getint();
    int i = 0;
    while (i < N) {
        int base = (i + seed) % 1009;
        integers[i] = {base, base + 7, base + 2, base + 9};
        floats[i] = {base + 0.5, base + 6.5, base + 2.5, base + 8.5};
        i = i + 1;
    }

    starttime();
    int sweep = 0;
    while (sweep < SWEEPS) {
        i = 0;
        while (i < N) {
            int4 integer_limit = {500, 500, 500, 500} + sweep % 17;
            float4 float_limit = {500.0, 500.0, 500.0, 500.0} + sweep % 19;
            int4 low = integers[i] < integer_limit;
            int4 high = floats[i] >= float_limit;
            masks[i] = low + high;
            integers[i] = (integers[i] + 3) % 1009;
            floats[i] = floats[i] * 0.999 + 0.5;
            i = i + 1;
        }
        sweep = sweep + 1;
    }
    stoptime();

    int checksum = 0;
    i = 0;
    while (i < N) {
        checksum = checksum + masks[i][0] + masks[i][1]
                   + masks[i][2] + masks[i][3];
        i = i + 1;
    }
    putint(checksum);
    putch(10);
    return 0;
}
