// Specifies width inference from initializers, parameters, and return values.
const int ITERATIONS = 1048576;

int<> integer_step(intvec value, int bias) {
    return value * 3 + bias;
}

vector<float> float_step(floatvec value, float bias) {
    return value * 0.5 + bias;
}

int main() {
    int seed = getint();
    int<> integers = {seed, seed + 1, seed + 2, seed + 3};
    float[] floats = {1.0, 1.5, 2.0, 2.5};

    starttime();
    int i = 0;
    while (i < ITERATIONS) {
        integers = integer_step(integers, i % 17) % 1009;
        floats = float_step(floats, 0.25);
        i = i + 1;
    }
    stoptime();

    putint(integers[0] + integers[1] + integers[2] + integers[3]);
    putch(10);
    int float_sum = (floats[0] + floats[1] + floats[2] + floats[3]) * 1000.0;
    putint(float_sum);
    putch(10);
    return 0;
}
